# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
.env.production.local

# AI agent skill scaffolding auto-installed by marketplace integrations (e.g. Neon)
.agents/
.claude/
skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts
src/generated/

# local file uploads (dev-only fallback; production uses S3/R2 once configured)
/public/uploads/
