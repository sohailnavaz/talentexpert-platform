generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / people
// ---------------------------------------------------------------------------

enum AdminRole {
  SUPER_ADMIN
  COUNSELLOR
  COORDINATOR
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(COORDINATOR)
  active             Boolean   @default(true)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  activityLogs  ActivityLog[]
  batchMessages BatchMessage[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model Student {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String
  whatsapp           String?
  passwordHash       String
  mustChangePassword Boolean  @default(true)
  avatarUrl          String?
  bio                String?
  age                Int?
  gender             Gender?
  studentNumber      Int      @unique @default(autoincrement())
  emailVerified      Boolean  @default(false)
  active             Boolean  @default(true)
  otpHash            String?
  otpExpiresAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enrollments     Enrollment[]
  payments        Payment[]
  leads           Lead[]
  jobApplications JobApplication[]
  badges          StudentBadge[]
  reviews         Review[]
  messages        BatchMessage[]
  sessionViews    SessionParticipant[]
  directMessages  DirectMessage[]

  @@index([email])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum DeliveryMode {
  ONLINE
  CLASSROOM
  WEEKEND
  CORPORATE
  INTERNSHIP
  WORKSHOP
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  courses Course[]
}

model Trainer {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  photoUrl           String?
  bio                String?
  phone              String?
  experienceYears    Int?
  expertise          String[] @default([])
  active             Boolean  @default(true)
  email              String?   @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  emailVerified      Boolean   @default(false)
  otpHash            String?
  otpExpiresAt       DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  lastLoginUserAgent String?
  createdAt          DateTime  @default(now())

  courses        Course[]
  batches        Batch[]
  messages       BatchMessage[]
  sessionViews   SessionParticipant[]
  directMessages DirectMessage[]

  @@index([email])
}

model Course {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  shortDescription String
  description      String         @db.Text
  categoryId       String?
  category         Category?      @relation(fields: [categoryId], references: [id])
  thumbnailUrl     String?
  brochureUrl      String?
  modes            DeliveryMode[] @default([])
  level            String?
  durationText     String?
  regularFee       Decimal        @db.Decimal(10, 2)
  trainerId        String?
  trainer          Trainer?       @relation(fields: [trainerId], references: [id])
  highlights       String[]       @default([])
  faqs             Json?
  status           CourseStatus   @default(DRAFT)
  featured         Boolean        @default(false)
  featuredOrder    Int            @default(0)
  trialEnabled     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  modules CourseModule[]
  batches Batch[]
  leads   Lead[]
  reviews Review[]

  @@index([status])
  @@index([slug])
}

model Review {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  authorName String
  rating     Int
  comment    String   @db.Text
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([courseId])
}

model CourseModule {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)

  topics CourseTopic[]

  @@index([courseId])
}

model CourseTopic {
  id       String       @id @default(cuid())
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title    String
  order    Int          @default(0)

  @@index([moduleId])
}

// ---------------------------------------------------------------------------
// Batches, offers, coupons
// ---------------------------------------------------------------------------

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

model Batch {
  id            String       @id @default(cuid())
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate     DateTime
  startTime     String
  mode          DeliveryMode
  trainerId     String?
  trainer       Trainer?     @relation(fields: [trainerId], references: [id])
  durationText  String?
  seatTotal     Int          @default(30)
  seatsFilled   Int          @default(0)
  fee           Decimal      @db.Decimal(10, 2)
  contactNumber String?
  status        BatchStatus  @default(UPCOMING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  offers        Offer[]
  enrollments   Enrollment[]
  sessions      ClassSession[]
  materials     Material[]
  messages      BatchMessage[]
  announcements Announcement[]

  @@index([courseId])
  @@index([status])
}

model Offer {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  label     String
  type      String // PERCENT | FLAT
  value     Decimal  @db.Decimal(10, 2)
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  @@index([batchId])
}

model Coupon {
  id         String    @id @default(cuid())
  code       String    @unique
  type       String // PERCENT | FLAT
  value      Decimal   @db.Decimal(10, 2)
  expiresAt  DateTime?
  usageLimit Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  enrollments Enrollment[]
}

// ---------------------------------------------------------------------------
// Enrolment & payments
// ---------------------------------------------------------------------------

enum EnrollmentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Enrollment {
  id             String           @id @default(cuid())
  enrollmentCode String?          @unique
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  batchId        String
  batch          Batch            @relation(fields: [batchId], references: [id])
  amountDue      Decimal          @db.Decimal(10, 2)
  amountPaid     Decimal          @default(0) @db.Decimal(10, 2)
  discountAmount Decimal          @default(0) @db.Decimal(10, 2)
  couponId       String?
  coupon         Coupon?          @relation(fields: [couponId], references: [id])
  status         EnrollmentStatus @default(PENDING)
  portalUnlocked Boolean          @default(false)
  isTrial        Boolean          @default(false)
  trialExpiresAt DateTime?
  hoursLogged    Decimal          @default(0) @db.Decimal(6, 1)
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  payments     Payment[]
  testAttempts TestAttempt[]
  attendances  Attendance[]

  @@index([studentId])
  @@index([batchId])
  @@index([status])
}

model TestAttempt {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String
  scorePercent Int
  completedAt  DateTime   @default(now())

  @@index([enrollmentId])
}

model Badge {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String
  icon        String
  criteria    Json
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  studentBadges StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
  @@index([studentId])
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(cuid())
  enrollmentId     String?
  enrollment       Enrollment?   @relation(fields: [enrollmentId], references: [id])
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  gateway          String        @default("razorpay")
  gatewayOrderId   String        @unique
  gatewayPaymentId String?
  gatewaySignature String?
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  failureReason    String?
  rawPayload       Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Student portal content
// ---------------------------------------------------------------------------

model ClassSession {
  id             String    @id @default(cuid())
  batchId        String
  batch          Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  topic          String
  date           DateTime
  time           String
  joinUrl        String
  roomName       String?
  recordingUrl   String?
  isFreePreview  Boolean   @default(false)
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  attendances  Attendance[]
  participants SessionParticipant[]

  @@index([batchId])
}

model SessionParticipant {
  id             String       @id @default(cuid())
  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id])
  trainerId      String?
  trainer        Trainer?     @relation(fields: [trainerId], references: [id])
  dailySessionId String       @unique
  joinedAt       DateTime
  leftAt         DateTime?
  durationSecs   Int?
  createdAt      DateTime     @default(now())

  @@index([classSessionId])
}

model Material {
  id            String   @id @default(cuid())
  batchId       String
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  title         String
  fileUrl       String
  isFreePreview Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([batchId])
}

model Attendance {
  id             String       @id @default(cuid())
  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  enrollmentId   String
  enrollment     Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  present        Boolean      @default(false)
  markedAt       DateTime     @default(now())

  @@unique([classSessionId, enrollmentId])
  @@index([classSessionId])
  @@index([enrollmentId])
}

enum MessageAuthorRole {
  STUDENT
  TRAINER
  ADMIN
}

model BatchMessage {
  id         String            @id @default(cuid())
  batchId    String
  batch      Batch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  authorRole MessageAuthorRole
  studentId  String?
  student    Student?          @relation(fields: [studentId], references: [id])
  trainerId  String?
  trainer    Trainer?          @relation(fields: [trainerId], references: [id])
  adminId    String?
  admin      AdminUser?        @relation(fields: [adminId], references: [id])
  body       String            @db.Text
  attachmentUrl  String?
  attachmentName String?
  createdAt  DateTime          @default(now())

  @@index([batchId])
}

model DirectMessage {
  id         String            @id @default(cuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trainerId  String
  trainer    Trainer           @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  senderRole MessageAuthorRole
  body       String            @db.Text
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([studentId, trainerId])
}

enum AnnouncementAudience {
  WEBSITE
  PORTAL
  BOTH
}

model Announcement {
  id        String               @id @default(cuid())
  title     String
  body      String
  audience  AnnouncementAudience @default(BOTH)
  priority  Int                  @default(0)
  showPopup Boolean              @default(false)
  batchId   String?
  batch     Batch?               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  startAt   DateTime             @default(now())
  endAt     DateTime?
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())

  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Leads / careers / content
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String
  phone          String
  courseInterest String?
  courseId       String?
  course         Course?    @relation(fields: [courseId], references: [id])
  message        String?
  sourcePage     String?
  status         LeadStatus @default(NEW)
  studentId      String?
  student        Student?   @relation(fields: [studentId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
}

model JobOpening {
  id          String   @id @default(cuid())
  title       String
  company     String   @default("Talent Expert")
  location    String
  experience  String
  description String   @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  applications JobApplication[]
}

model JobApplication {
  id           String     @id @default(cuid())
  jobOpeningId String
  jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  studentId    String?
  student      Student?   @relation(fields: [studentId], references: [id])
  name         String
  email        String
  phone        String
  resumeUrl    String?
  createdAt    DateTime   @default(now())

  @@index([jobOpeningId])
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String
  content       String     @db.Text
  coverImageUrl String?
  category      String?
  authorName    String     @default("Talent Expert Team")
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status])
  @@index([slug])
}

model Testimonial {
  id          String   @id @default(cuid())
  studentName String
  courseName  String?
  quote       String   @db.Text
  rating      Int      @default(5)
  photoUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Placement {
  id             String   @id @default(cuid())
  studentName    String
  company        String
  role           String
  photoUrl       String?
  companyLogoUrl String?
  batch          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model ContentBlock {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
}
