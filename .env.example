DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Talent Expert"

# Auth
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Razorpay (test mode keys - replace with real test keys from your Razorpay dashboard)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Email (Resend - optional in dev, logs to console if absent)
RESEND_API_KEY=""
EMAIL_FROM="Talent Expert <no-reply@talentexpertedu.com>"

# Cron (protects /api/cron/* routes from being called by anyone but Vercel Cron - optional in dev)
CRON_SECRET=""

# WhatsApp Business API (optional in dev, logs to console if absent)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# File storage (Cloudflare R2 / S3-compatible). Falls back to local /public/uploads in dev if absent.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
